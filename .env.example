# Database (Supabase Postgres via Prisma)
DATABASE_URL=            # pooled connection string (Transaction pooler, port 6543)
DIRECT_URL=              # direct connection string (port 5432), used only for migrations

# Supabase (Storage in Phase 1 — app data goes through Prisma, not the Supabase client)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PAYMENT_SCREENSHOTS_BUCKET=payment-screenshots   # PRIVATE bucket — create it in Supabase Storage, do not make it public

# Supabase Auth (student portal only — admin auth is unaffected, see ADMIN_SESSION_SECRET below).
# Project Settings -> API -> Project API keys -> "anon public". Safe to expose to the
# browser (that's what NEXT_PUBLIC_ means here) — it has no access without a signed-in
# session, and student data access still goes through Prisma with a server-side DAL
# check, not Supabase RLS. Never put the service role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=              # must be a verified sending domain, e.g. hello@abelkirar.com
CONTACT_NOTIFICATION_EMAIL=     # owner's inbox for contact-form alerts
ADMIN_NOTIFICATION_EMAILS=      # comma-separated list, e.g. owner@abelkirar.com,manager@abelkirar.com

# Admin auth (see scripts/create-admin.ts to create accounts)
ADMIN_SESSION_SECRET=           # random 32+ byte string, e.g. `openssl rand -base64 32` — signs admin session cookies

# Manual payment instructions shown to customers at checkout
ZELLE_RECIPIENT_NAME=
ZELLE_RECIPIENT_EMAIL_OR_PHONE=
ZELLE_ADDITIONAL_INSTRUCTIONS=  # optional, e.g. "Please send as Friends & Family"
CASHAPP_CASHTAG=
CASHAPP_ADDITIONAL_INSTRUCTIONS=  # optional, e.g. "Allow up to 24 hours for us to confirm"

# Twilio (SMS + WhatsApp admin notifications). Email is always the primary
# channel — these are additive and OFF by default until you explicitly opt in.
TWILIO_NOTIFICATIONS_ENABLED=false  # set to "true" to allow any Twilio API request at all
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=         # a Twilio phone number, E.164, e.g. +15551234567
TWILIO_SMS_RECIPIENTS=          # comma-separated E.164 numbers, e.g. +15551234567,+15559876543
TWILIO_WHATSAPP_FROM=           # Twilio WhatsApp sender, E.164 (no "whatsapp:" prefix — added internally), e.g. +14155238886
TWILIO_WHATSAPP_RECIPIENTS=     # comma-separated E.164 numbers (no "whatsapp:" prefix), e.g. +251911234567

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
