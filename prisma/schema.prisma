generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  KIRAR
  BEGENA
  MESENKO
  TSENATSL
  MEKWAMIYA
  PICK_UPS
  KABA
  OTHER
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum OrderType {
  PRODUCT
  COURSE
  SUBSCRIPTION
  CUSTOM_QUOTE
}

enum ContactStatus {
  NEW
  READ
  RESPONDED
}

enum PaymentMethod {
  ZELLE
  CASH_APP
  EUR_BANK_TRANSFER
  STRIPE_LEGACY
}

enum PaymentStatus {
  PENDING_VERIFICATION
  PAID
  PAYMENT_NOT_FOUND
  REFUNDED
  PENDING_QUOTE
}

enum PaymentRegion {
  US
  EUROZONE
}

/// Delivery state of an outbound order-notification attempt (SMS/WhatsApp).
/// Null on Order means no attempt has been made yet for that channel.
enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Product {
  id                   String          @id @default(cuid())
  slug                 String          @unique
  name                 String
  /// Optional subdivision name shown alongside the product name, e.g.
  /// "Desalegn Kirar" for a Kirar variant built to that player's spec.
  variantName          String?
  category             ProductCategory
  description          String
  basePrice            Int
  images               Json
  variants             Json            @default("[]")
  customizationOptions Json
  isActive             Boolean         @default(true)
  /// Whether this product is also available as a custom order (distinct from
  /// the fixed, price-affecting choices in customizationOptions).
  isCustomMade         Boolean         @default(false)
  customMadeDetails    String?
  customMadeImageUrl   String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  orderItems OrderItem[]
}

/// Community announcement (event or update) shown read-only on the public
/// Community page. Admin-managed only — there is no public submission.
model Announcement {
  id          String    @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  eventDate   DateTime?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id                      String         @id @default(cuid())
  orderNumber             String?        @unique
  // Legacy Stripe fields — no longer written by new orders, kept so
  // historical Stripe orders remain intact. See PaymentMethod.STRIPE_LEGACY.
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?
  status                  OrderStatus    @default(PENDING)
  orderType               OrderType      @default(PRODUCT)
  paymentMethod           PaymentMethod?
  paymentRegion           PaymentRegion?
  paymentStatus           PaymentStatus  @default(PENDING_VERIFICATION)
  customerEmail           String?
  customerName            String?
  customerPhone           String?
  shippingAddress         Json?
  // Locale the customer was checking out in (NEXT_LOCALE cookie at order
  // creation), so later admin-triggered emails (e.g. payment confirmed) can
  // still be sent in the customer's language instead of always English.
  locale                  String         @default("en")
  currency                String         @default("usd")
  subtotal                Int
  total                   Int
  paymentConfirmedById    String?
  paymentConfirmedBy      Admin?         @relation("PaymentConfirmedBy", fields: [paymentConfirmedById], references: [id])
  paymentConfirmedAt      DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  // New-order Twilio notification tracking (business-contact SMS/WhatsApp).
  // A non-null status means a send was already attempted for that channel —
  // this is the idempotency guard against duplicate sends on retry.
  smsStatus          NotificationDeliveryStatus?
  smsMessageSid      String?
  smsSentAt          DateTime?
  smsError           String?
  whatsappStatus     NotificationDeliveryStatus?
  whatsappMessageSid String?
  whatsappSentAt     DateTime?
  whatsappError      String?

  // Custom Made quote-request fields (docs plan, Phase 1 — schema only, no
  // application code reads or writes these yet). Nullable; populated only
  // for OrderType.CUSTOM_QUOTE orders, never for the manual PRODUCT flow.
  customOrderDescription String?
  customOrderImagePath   String?
  quotedAt               DateTime?
  quotedById             String?
  quotedBy               Admin?         @relation("QuotedBy", fields: [quotedById], references: [id])

  items                OrderItem[]
  paymentConfirmations PaymentConfirmation[]
  notes                OrderNote[]
  notificationLogs     OrderNotificationLog[]
}

model Admin {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  displayName  String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  /// Set whenever this admin's password is changed. Compared against the
  /// session JWT's `iat` claim in verifyAdminSession() — any token issued
  /// before this timestamp is rejected, invalidating every other session on
  /// a password change. The current session is reissued with a fresh token
  /// in the same request, so it survives. Truncated to whole seconds when
  /// written (see the password route) to match JWT `iat`'s native
  /// second-granularity and avoid a same-second comparison race.
  passwordChangedAt DateTime?

  confirmedOrders Order[]     @relation("PaymentConfirmedBy")
  quotedOrders    Order[]     @relation("QuotedBy")
  notes           OrderNote[]

  createdWeeklyPractices WeeklyPractice[]
  createdMonthlyLogs     MonthlyLog[]
  assignedStudents       StudentProfile[]
  teacherPrivateNotes    TeacherPrivateNote[]
  signedOffMilestones    StudentMilestone[]
}

/// A single logged practice session — duration and a short note on what
/// was worked on, self-rated by the student. Minutes and the self-rating
/// are informative for the student and the teacher, never a score: no
/// streaks, no gamification, no automatic scoring, no quality rating
/// derived from minutes, and nothing here should ever be aggregated into a
/// judgement of the student. A future reader adding any of that needs a
/// fresh decision, not an "improvement" to this comment.
///
/// No unique constraint on (studentId, practicedAt) — a student may log
/// more than one session in a day; aggregation by date happens in the
/// query, not by constraining the row.
model PracticeLogEntry {
  id               String          @id @default(cuid())
  studentId        String
  student          StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weeklyPracticeId String?
  weeklyPractice   WeeklyPractice? @relation(fields: [weeklyPracticeId], references: [id], onDelete: SetNull)
  /// The date/time the practice actually happened — distinct from
  /// createdAt (when the row was written, which may be later).
  practicedAt      DateTime
  durationMinutes  Int
  /// What the student worked on, in their own words.
  focus            String
  /// Self-reported, short free text — e.g. "Struggled", "OK", "Good" — how
  /// the session felt, not a skill/quality grade. A plain string, not an
  /// enum: the suggested values are hardcoded client-side in the practice
  /// log form (no admin editor for them — nobody has asked for one), not
  /// modeled here. MUST NEVER be averaged, scored, or turned into any kind
  /// of metric — an average of even named states is still a grade, which
  /// is exactly what this field must not become. This is the field a
  /// future reader is most likely to try to "improve"; don't.
  selfRating       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([studentId, practicedAt])
  @@index([weeklyPracticeId])
}

/// Customer-submitted proof of a Zelle/Cash App payment. Submitting one does
/// NOT mark the order as paid — an admin must still confirm it manually.
model PaymentConfirmation {
  id                   String   @id @default(cuid())
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderName           String
  amountSent           Int
  sentAt               DateTime
  transactionReference String?
  /// Object path in the private payment-screenshots bucket, not a public URL.
  screenshotPath       String?
  createdAt            DateTime @default(now())
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

/// One row per outbound order-notification-email attempt (customer- or
/// admin-facing), across the order's whole lifecycle — order-pending,
/// payment-confirmed, quote-ready, etc. Deliberately a child table rather
/// than fixed columns on Order: an order sends multiple distinct emails
/// over its lifetime, so a fixed pair of columns would be silently
/// overwritten by whichever email sent most recently, losing both the
/// history and the ability to tell which specific email failed. No
/// application code reads or writes this table yet (Phase 1 — schema only).
model OrderNotificationLog {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Which notificationService method produced this attempt, e.g.
  /// "customerOrderPending", "adminNewOrder", "customerQuoteReady". A plain
  /// string rather than a Postgres enum — same reasoning as
  /// StudentProfile.locale below: this set will keep growing as new
  /// notification types are added, and an enum would need its own
  /// ALTER TYPE migration every time.
  kind      String
  status    NotificationDeliveryStatus
  error     String?
  createdAt DateTime                   @default(now())

  @@index([orderId])
}

/// Simple DB-backed rate limiter (no Redis in this project). Rows older than
/// the relevant window are opportunistically deleted by the caller.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model OrderItem {
  id                    String   @id @default(cuid())
  orderId               String
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product? @relation(fields: [productId], references: [id])
  selectedCustomization Json
  /// Resolved snapshot of the customer's picks at order-creation time —
  /// distinct from selectedCustomization above, which stays the raw
  /// {fieldId: choiceId} map used for repricing/audit and is never
  /// overwritten. Written once, at creation, never touched again, so a
  /// later edit to Product.customizationOptions can never change what an
  /// old order appears to say the customer chose or what each choice cost
  /// at the time — the exact case this exists for (an old-invoice query
  /// after options have since changed).
  /// Shape: Record<fieldId, { fieldLabel: string; choiceLabel: string;
  /// priceModifier: number; imageUrl?: string }> — imageUrl present only
  /// when the field's type is "image-select". Nothing validates a Json
  /// column at the database level, so this comment is the only contract;
  /// keep it in sync with whatever writes it.
  /// Schema only for now — no application code reads or writes this yet
  /// (see docs/DECISIONS.md).
  selectedCustomizationSnapshot Json?
  unitPrice             Int
  quantity              Int      @default(1)
  productNameSnapshot   String
  productImageSnapshot  String?
  /// Product.variantName at order time (e.g. "Desalegn Kirar"), snapshotted
  /// the same way productNameSnapshot is — survives later product edits/deletes.
  variantNameSnapshot   String?
}

model ContactSubmission {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  topic     String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  confirmed        Boolean   @default(false)
  unsubscribeToken String    @unique @default(cuid())
  source           String?
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?
}

// ---------------------------------------------------------------------------
// Student platform. Distinct from the Admin/bcrypt/JWT system above — student
// identity is a Supabase Auth user, mirrored onto StudentProfile below. Admin
// login is completely unaffected; requireAdminPage/requireAdminApi still gate
// every /admin/* route exactly as before. See docs/student-platform-spec.md.
// ---------------------------------------------------------------------------

/// Only ever STUDENT in practice today — kept as an enum (rather than a bare
/// boolean) so a future non-student Supabase-authenticated role is additive,
/// not a migration. There is deliberately no separate User table: every
/// Supabase-authenticated identity in this app is a student, so folding
/// supabaseUserId/email/role directly onto StudentProfile avoids an
/// always-1:1 join with no current benefit.
enum Role {
  ADMIN
  STUDENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum StudentLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WeeklyPracticeStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  COMPLETED
  MISSED
}

enum AttachmentUploadedBy {
  ADMIN
  STUDENT
}

enum StudentMilestoneStatus {
  IN_PROGRESS
  SUBMITTED
  ACHIEVED
}

model StudentProfile {
  id             String @id @default(cuid())
  /// Supabase Auth's auth.users.id — the actual login identity for this student.
  supabaseUserId String @unique
  email          String @unique
  role           Role   @default(STUDENT)

  fullName       String
  phone          String?
  level          StudentLevel?
  enrollmentDate DateTime?
  /// Re-checked against the DB on every authenticated request (never trust
  /// the JWT alone) — the same pattern verifyAdminSession uses for Admin.isActive.
  status         StudentStatus @default(ACTIVE)
  notes          String?
  /// "en" | "am" — validated app-side via src/i18n/locale.ts's isLocale(),
  /// same plain-string approach already used for Order.locale, rather than a
  /// second Prisma enum that would need to stay in sync with that file's
  /// `locales` array by hand.
  locale         String        @default("en")
  /// Set only when the student actually finishes /student/set-password (invite
  /// or recovery) and saves a password — NOT when they merely click the link.
  /// Replaces the old last_sign_in_at proxy (see supabase-admin-auth.ts git
  /// history), which over-counted "clicked but abandoned" as activated.
  activatedAt DateTime?

  /// The teacher this student is currently associated with — one field, not
  /// a feature: no multi-teacher management UI is built on top of this yet.
  /// Nullable rather than backfilled, so existing students aren't silently
  /// assigned to whichever admin id a migration might otherwise hardcode.
  teacherId String?
  teacher   Admin?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklyPractices WeeklyPractice[]
  monthlyLogs     MonthlyLog[]
  studentNotes        StudentNote[]
  teacherPrivateNotes TeacherPrivateNote[]
  studentMilestones   StudentMilestone[]
  practiceLogEntries  PracticeLogEntry[]

  @@index([status])
}

/// SECURITY NOTE — read before touching any student-facing query (Stage 4+).
/// This table carries THREE admin-only fields: internalCurriculumRef,
/// currentTechnique, teacherNotes. Unlike Milestone (structurally invisible
/// to a student, since a student route only ever joins through
/// StudentMilestone), WeeklyPractice IS queried directly by the student's
/// own assignment route — there is no structural barrier here. Protection
/// is an explicit `select` naming only the safe fields on every
/// student-facing query against this table. A bare `findUnique`/`findMany`
/// with no `select` (or a `select` that forgets to exclude these three)
/// leaks admin-only content straight into a student session. Never assume
/// this is handled elsewhere — check the query itself, every time.
model WeeklyPractice {
  id            String               @id @default(cuid())
  studentId     String
  student       StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekTitle     String
  weekStartDate DateTime
  weekEndDate   DateTime
  instructions  String?
  goals         String?
  /// ADMIN-ONLY — see the model-level security note above.
  teacherNotes  String?
  status        WeeklyPracticeStatus @default(NOT_STARTED)

  /// --- Hybrid assignment model additions (Student Dashboard MVP) ---
  /// Optional internal curriculum skill/exercise/reference id. ADMIN-ONLY —
  /// see the model-level security note above. Plain string: no curriculum
  /// catalog table exists or is being built as part of this MVP.
  internalCurriculumRef String?
  /// Neutral internal technique reference, per CLAUDE.md's hard rule: do
  /// not rename or rewrite the curriculum, and do not attach the old
  /// E32/E33/C18/E34 mapping (unresolved). ADMIN-ONLY — see the model-level
  /// security note above. A student sees only teacher-authored text
  /// (weekTitle / instructions), never this field's raw value.
  currentTechnique String?
  /// Whether the student must upload a recording for this assignment.
  recordingRequired Boolean @default(false)

  studentSubmission String?
  submittedAt       DateTime?
  adminFeedback     String?
  /// Plain string, not an enum — same reasoning as StudentProfile.locale /
  /// OrderNotificationLog.kind: this set (On track / Needs more practice /
  /// Milestone met, per the brief) is expected to evolve without an
  /// ALTER TYPE migration every time.
  feedbackStatus    String?
  feedbackAt        DateTime?
  reviewedAt        DateTime?
  completedAt       DateTime?
  /// Set when an admin explicitly reopens a SUBMITTED entry back to
  /// IN_PROGRESS, unlocking student editing. A subsequent student edit is an
  /// intentional, admin-authorized overwrite, not a silent one — see
  /// docs/student-platform-spec.md for why this isn't a full submission-
  /// history table (yet).
  reopenedAt        DateTime?
  reopenCount       Int       @default(0)

  createdById String
  createdBy   Admin    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments  WeeklyPracticeAttachment[]
  studentNotes StudentNote[]
  practiceLogEntries PracticeLogEntry[]

  @@index([studentId, weekStartDate])
  @@index([status])
}

model WeeklyPracticeAttachment {
  id               String               @id @default(cuid())
  weeklyPracticeId String
  weeklyPractice   WeeklyPractice       @relation(fields: [weeklyPracticeId], references: [id], onDelete: Cascade)
  uploadedBy       AttachmentUploadedBy
  /// Object path in the private student-files bucket, not a public URL.
  storagePath      String
  fileName         String
  mimeType         String
  fileSize         Int
  /// Teacher-written or date-based label ONLY — per the spec, this must
  /// never be auto-generated from internal curriculum text. Enforced by
  /// authoring discipline in the route/UI that writes this, not by the
  /// database.
  label             String?
  /// Teacher can flag a recording as a milestone marker for later
  /// comparison (the comparison UI itself is Phase 2 — this just captures
  /// the flag from day one, per the spec).
  isMilestoneMarker Boolean @default(false)
  createdAt        DateTime             @default(now())

  @@index([weeklyPracticeId])
}

/// Short, student-authored note attached to a submission (or standalone —
/// weeklyPracticeId is nullable because Session History doesn't have its
/// own table yet in this MVP; a note can exist without one). Distinct from
/// WeeklyPractice.studentSubmission (the practice content itself) and from
/// StudentProfile.notes (an admin-editable flat field, unrelated). A
/// student may only ever read/write their own rows.
model StudentNote {
  id               String          @id @default(cuid())
  studentId        String
  student          StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weeklyPracticeId String?
  weeklyPractice   WeeklyPractice? @relation(fields: [weeklyPracticeId], references: [id], onDelete: SetNull)
  body             String
  createdAt        DateTime        @default(now())

  @@index([studentId, createdAt])
  @@index([weeklyPracticeId])
}

/// Private per-student teacher observations — teaching strategy, personal
/// context, prep reminders. NEVER expose through any student-facing route,
/// API, server action, page payload, or export, by any path. See CLAUDE.md
/// hard rules and docs/dashboard/student-dashboard-spec-v1.md §7.J.
/// Distinct from StudentProfile.notes (a single admin-editable flat field)
/// and from StudentNote (student-authored).
model TeacherPrivateNote {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Admin          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime       @default(now())

  @@index([studentId, createdAt])
}

/// Admin-managed milestone catalog, scoped per level. NEVER shipped whole
/// to a student client — a student route must only ever read this table by
/// joining through StudentMilestone for their own rows, never query it
/// directly. A milestone with no matching StudentMilestone row for a given
/// student is, structurally, invisible to that student — that IS the
/// "future milestones hidden" enforcement, not a flag to check.
model Milestone {
  id               String       @id @default(cuid())
  level            StudentLevel
  /// Plain-language, student-facing name. The teacher authoring this must
  /// write it safely — same authoring discipline as WeeklyPractice.weekTitle.
  label            String
  /// Plain-language description shown to the student.
  description      String?
  /// Internal pass criteria — NEVER shown to a student.
  internalCriteria String?
  /// "order" is a reserved word in Postgres — quotable but avoidable, and
  /// nothing depends on the name "order" yet.
  sortOrder        Int
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  studentMilestones StudentMilestone[]

  @@index([level, sortOrder])
}

/// Per-student milestone status. Teacher sign-off required for ACHIEVED —
/// no automatic completion (spec §7.G).
model StudentMilestone {
  id             String                 @id @default(cuid())
  studentId      String
  student        StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  milestoneId    String
  milestone      Milestone              @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  status         StudentMilestoneStatus @default(IN_PROGRESS)
  assignedAt     DateTime               @default(now())
  achievedAt     DateTime?
  /// Shown to the student alongside an achieved milestone (spec §7.G:
  /// "achieved milestones with dates and teacher comment").
  teacherComment String?
  signedOffById  String?
  signedOffBy    Admin?                 @relation(fields: [signedOffById], references: [id], onDelete: Restrict)

  @@unique([studentId, milestoneId])
  @@index([studentId, status])
}

model MonthlyLog {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month     Int // 1-12
  year      Int

  attendanceSummary   String?
  practiceConsistency String?
  skillsPracticed     String?
  strengths           String?
  areasForImprovement String?
  teacherComments     String?
  studentComments     String?
  progressRating      Int?
  goalsNextMonth      String?

  publishedToStudent Boolean   @default(false)
  publishedAt        DateTime?

  createdById String
  createdBy   Admin    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments MonthlyLogAttachment[]

  @@unique([studentId, month, year])
  @@index([studentId, year, month])
}

model MonthlyLogAttachment {
  id           String     @id @default(cuid())
  monthlyLogId String
  monthlyLog   MonthlyLog @relation(fields: [monthlyLogId], references: [id], onDelete: Cascade)
  /// Object path in the private student-files bucket, not a public URL.
  storagePath  String
  fileName     String
  mimeType     String
  fileSize     Int
  createdAt    DateTime   @default(now())

  @@index([monthlyLogId])
}
